# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
# Public base URL (no trailing slash). Used for SEO, OG images, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Firebase — CLIENT (safe to expose; used in the browser for Auth)
# Project settings → General → Your apps → SDK setup and configuration
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Firebase — ADMIN (SECRET; server only. NEVER prefix with NEXT_PUBLIC)
# Project settings → Service accounts → Generate new private key
# Paste the private key with literal \n escapes, wrapped in quotes.
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS=amstersudhan633@gmail.com

# ------------------------------------------------------------------
# Email notifications for contact form (OPTIONAL — uses Resend)
# Leave blank to skip email; inquiries are still saved to Firestore.
# ------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
