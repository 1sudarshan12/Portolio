# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
# Public base URL (no trailing slash). Used for SEO, OG images, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Firebase — CLIENT (safe to expose; used in the browser for Auth)
# Project settings → General → Your apps → SDK setup and configuration
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Firebase — ADMIN (SECRET; server only. NEVER prefix with NEXT_PUBLIC)
# Project settings → Service accounts → Generate new private key
# Paste the private key with literal \n escapes, wrapped in quotes.
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS=amstersudhan633@gmail.com

# ------------------------------------------------------------------
# Contact form email (Resend) — email-only, no Firebase needed here
# ------------------------------------------------------------------
# REQUIRED to actually receive messages. Create a free key at resend.com.
# NOTE: the default sender (onboarding@resend.dev) only delivers to the email
# you SIGNED UP to Resend with — so sign up with amstersudhan633@gmail.com,
# or set CONTACT_NOTIFY_EMAIL below to your Resend signup address.
# Leave blank in dev: the form still "succeeds" but logs a warning (no email).
RESEND_API_KEY=

# OPTIONAL — only set once you've verified your own domain in Resend
# (e.g. hello@sudarshanadhikari.com). Defaults to onboarding@resend.dev.
RESEND_FROM_EMAIL=

# OPTIONAL — where inquiries are delivered. Defaults to your profile email
# (amstersudhan633@gmail.com).
CONTACT_NOTIFY_EMAIL=
